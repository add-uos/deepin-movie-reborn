prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/include/libgpuinfo

Name: libgpuinfo
Description: deepin-gpuinfo development file
Version: @PROJECT_VERSION@
Libs: -llibgpuinfo
Cflags: -I${includedir}
Requires:  pkg-config,  libva-dev (>= 2.1),  libvdpau-dev,  libdrm-dev (>= 2.4), libwayland-dev (>= 1.0.0) [linux-any],
                        libx11-dev, libnvidia-ml1,libpciaccess-dev,
     