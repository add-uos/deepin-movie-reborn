/*

 */

#ifndef __GPUINFO_VERSION_H_
#define __GPUINFO_VERSION_H_

#include "config.h"

#if defined(__GNUC__) || defined(__INTEL_COMPILER)
#define __ID(string) __asm__(".ident\t\"" string "\"")
#else
#define __ID(string) static const char rcsid[] __unused = string
#endif

#ifdef __cplusplus
extern "C" {
#endif

#define GPUINFO_VERSION_MAJOR @gpuinfoVERSION_MAJOR@
#define GPUINFO_VERSION_MINOR @gpuinfoVERSION_MINOR@
#define GPUINFO_VERSION_PATCH @gpuinfoVERSION_PATCH@

#define GPUINFO_VERSION_STRING "@gpuinfoVERSION_MAJOR@.@gpuinfoVERSION_MINOR@.@gpuinfoVERSION_PATCH@"

//config.h
#ifdef NONLS
#define _(String) (String)
#define N_(String) String
#define textdomain(Domain)
#define bindtextdomain(Package, Directory)
#else
#include <libintl.h>
#define _(String) gettext (String)
#define gettext_noop(String) String
#define N_(String) gettext_noop (String)
#endif

#ifndef PACKAGE
#define PACKAGE "deepin-gpuinfo"
#endif

#ifndef PREFIX
#define PREFIX "/usr"
//#define PREFIX "../config"
#endif

#ifndef SBINDIR
#define SBINDIR PREFIX"/sbin"
#endif

#ifndef DATADIR
//#define DATADIR PREFIX"/share/lshw"
#define DATADIR PREFIX
#endif

#ifndef MANDIR
#define MANDIR PREFIX"/share/man"
#endif

#ifndef LOCALEDIR
#define LOCALEDIR PREFIX"/share/locale"
#endif


#ifdef __x86_64__
    #define USR_LIB_PATH  "/usr/lib/x86_64-linux-gnu"
#elif __mips64__
    #define USR_LIB_PATH  "/usr/lib/mips64el-linux-gnuabi64"
#elif __aarch64__
    #define USR_LIB_PATH  "/usr/lib/aarch64-linux-gnu"
#elif __sw_64__
    #define USR_LIB_PATH  "/usr/lib/sw_64-linux-gnu"
#elif __i686__
    #define USR_LIB_PATH  "/usr/lib/i386-linux-gnu"
#elif __loongarch64__
    #define USR_LIB_PATH  "/usr/lib/loongarch64-linux-gnu"
#else
    #define USR_LIB_PATH  __INSTALL_LIB_PATH__
#endif


#ifdef __cplusplus
}
#endif

#endif // __GPUINFO_VERSION_H_
